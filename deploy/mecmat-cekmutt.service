# /etc/systemd/system/mecmat-cekmutt.service — installed by first-install.sh / after-deploy.sh.
# Shares one 1-vCPU VPS with Reaction ERP: CPU weight and a memory ceiling keep this site from
# starving the ERP (CLAUDE.md "สิ่งที่ใช้ร่วมกัน").
[Unit]
Description=MECMAT CEKMUTT research group web app
After=network.target

[Service]
Type=simple
User=mecmat
Group=mecmat
WorkingDirectory=/opt/mecmat-cekmutt
ExecStart=/opt/mecmat-cekmutt/Mecmat.Server
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=Urls=http://127.0.0.1:5180
Environment=Mecmat__DataRoot=/var/lib/mecmat-cekmutt
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_gcServer=0
Environment=TZ=Asia/Bangkok
Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5
CPUWeight=50
MemoryMax=700M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mecmat-cekmutt
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
