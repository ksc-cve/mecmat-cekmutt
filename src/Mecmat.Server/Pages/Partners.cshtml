@page "/partners"
@model PartnersModel
<div class="pagehead"><div class="wrap"><h1>@Model.L("nav.partners")</h1><p class="sub">@Model.L("partners.intro")</p></div></div>
<div class="wrap">
  @if (Model.Orgs.Count == 0) { <p class="muted">@Model.L("common.none")</p> }
  <div class="logos">
  @foreach (var o in Model.Orgs)
  {
    <div class="logo">
      @if (o.LogoFileId != null) { <img src="@SitePageModel.Img(o.LogoFileId)" alt="" loading="lazy"> }
      <strong>@if (o.Website != null) { <a href="@o.Website" rel="noopener">@Model.Pick(o.NameTh, o.NameEn)</a> } else { @Model.Pick(o.NameTh, o.NameEn) }</strong>
      <span class="muted small">@SiteText.Enum(o.Kind, Model.En)@(o.Country != null ? " · " + o.Country : "")</span>
    </div>
  }
  </div>
</div>
