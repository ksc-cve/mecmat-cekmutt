@page "/contact"
@model ContactModel
<div class="pagehead"><div class="wrap"><h1>@Model.L("nav.contact")</h1></div></div>
<div class="wrap two">
  <div>
    @if (Model.PageContent?.BodyTh != null) { <div class="prose">@Html.Raw(HtmlSanitizer.Clean(Model.Pick(Model.PageContent.BodyTh, Model.PageContent.BodyEn)))</div> }
    <section class="box"><h3>@Model.L("contact.address")</h3>
      <p>@Model.Pick(Model.S("site.nameTh"), Model.S("site.nameEn"))<br>@Model.Pick(Model.S("site.departmentTh"), Model.S("site.departmentEn"))<br>@Model.Pick(Model.S("site.addressTh"), Model.S("site.addressEn"))</p>
      @if (!string.IsNullOrEmpty(Model.S("site.phone"))) { <p>☎ @Model.S("site.phone")</p> }
      @if (!string.IsNullOrEmpty(Model.S("site.email"))) { <p>✉ <a href="mailto:@Model.S("site.email")">@Model.S("site.email")</a></p> }
    </section>
  </div>
  <div>
    <h2>@Model.L("contact.write")</h2>
    @if (Model.Sent) { <p class="notice ok" role="status">@Model.L("contact.sent")</p> }
    else
    {
      @if (Model.Error != null) { <p class="notice err" role="alert">@Model.Error</p> }
      <form method="post" asp-antiforgery="true" class="ui-form siteform" action="@Model.Href("/contact")">
        <div class="ui-field"><label for="Name">@Model.L("form.name") *</label><input class="ui-input" id="Name" name="Name" value="@Model.Name" required maxlength="200" autocomplete="name"></div>
        <div class="ui-field"><label for="Email">@Model.L("form.email") *</label><input class="ui-input" id="Email" name="Email" type="email" value="@Model.Email" required maxlength="200" autocomplete="email"></div>
        <div class="ui-field"><label for="Phone">@Model.L("form.phone")</label><input class="ui-input" id="Phone" name="Phone" type="tel" value="@Model.Phone" maxlength="40" autocomplete="tel"></div>
        <div class="ui-field"><label for="Subject">@Model.L("form.subject") *</label><input class="ui-input" id="Subject" name="Subject" value="@Model.Subject" required maxlength="300"></div>
        <div class="ui-field span2"><label for="Message">@Model.L("form.message") *</label><textarea class="ui-textarea" id="Message" name="Message" rows="6" required maxlength="5000">@Model.Message</textarea></div>
        <div class="hp" aria-hidden="true"><label for="Website">Website</label><input id="Website" name="Website" tabindex="-1" autocomplete="off"></div>
        <label class="ui-check span2"><input type="checkbox" name="Consent" value="true" required> <span>@Model.L("form.consent") (<a href="@Model.Href("/privacy")">@Model.L("nav.privacy")</a>)</span></label>
        <div class="span2"><button class="ui-btn primary" type="submit">@Model.L("form.send")</button></div>
      </form>
    }
  </div>
</div>
